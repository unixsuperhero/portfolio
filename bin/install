#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
LABEL="com.${USER}.portfolio"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
API_LABEL="com.${USER}.portfolio-api"
API_PLIST="$HOME/Library/LaunchAgents/$API_LABEL.plist"
PORT="${PORTFOLIO_PORT:-4387}"
BUN=$(command -v bun || true)
PANDOC=$(command -v pandoc || true)
PASTRY=$(command -v pastry || true)

[[ "$(uname -s)" == "Darwin" ]] || { echo "portfolio install: macOS is required" >&2; exit 1; }
[[ -n "$BUN" ]] || { echo "portfolio install: install Bun first: brew install bun" >&2; exit 1; }
[[ -n "$PANDOC" ]] || { echo "portfolio install: install Pandoc first: brew install pandoc" >&2; exit 1; }

mkdir -p "$HOME/Library/LaunchAgents" "$HOME/bin" "$ROOT/logs"
cp "$ROOT/bin/h-docs" "$HOME/bin/h-docs"
cp "$ROOT/bin/mdoc" "$HOME/bin/mdoc"
cp "$ROOT/bin/ports-scan" "$HOME/bin/ports-scan"
ln -sf "$ROOT/bin/pf-oncall" "$HOME/bin/pf-oncall"
chmod +x "$HOME/bin/h-docs" "$HOME/bin/mdoc" "$HOME/bin/ports-scan" "$HOME/bin/pf-oncall"

cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array><string>$BUN</string><string>run</string><string>$ROOT/app.js</string></array>
  <key>WorkingDirectory</key><string>$ROOT</string>
  <key>EnvironmentVariables</key>
  <dict><key>HOME</key><string>$HOME</string><key>PORT</key><string>$PORT</string>$([[ -n "$PASTRY" ]] && printf '<key>PASTRY_BIN</key><string>%s</string>' "$PASTRY")</dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>$ROOT/logs/stdout.log</string>
  <key>StandardErrorPath</key><string>$ROOT/logs/stderr.log</string>
</dict>
</plist>
EOF

cat > "$API_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$API_LABEL</string>
  <key>ProgramArguments</key>
  <array><string>$BUN</string><string>run</string><string>$ROOT/packages/api/src/server.ts</string></array>
  <key>WorkingDirectory</key><string>$ROOT</string>
  <key>EnvironmentVariables</key>
  <dict><key>HOME</key><string>$HOME</string><key>PORTFOLIO_API_PORT</key><string>4388</string><key>PATH</key><string>$HOME/.config/gohan/bin:$HOME/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>$ROOT/logs/oncall-api-stdout.log</string>
  <key>StandardErrorPath</key><string>$ROOT/logs/oncall-api-stderr.log</string>
</dict>
</plist>
EOF

plutil -lint "$PLIST" "$API_PLIST" >/dev/null

if [[ ! -f "$ROOT/portfolio.sqlite" && -f "$HOME/claude/index.json" ]]; then
  "$BUN" run "$ROOT/import.js"
fi

for old in "$HOME/Library/LaunchAgents"/com.*.portfolio.plist; do
  [[ -f "$old" && "$old" != "$PLIST" ]] || continue
  [[ "$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:2' "$old" 2>/dev/null || true)" == "$ROOT/app.js" ]] || continue
  [[ "$(/usr/libexec/PlistBuddy -c 'Print :EnvironmentVariables:PORT' "$old" 2>/dev/null || true)" == "$PORT" ]] || continue
  launchctl bootout "gui/$(id -u)/$(basename "$old" .plist)" >/dev/null 2>&1 || true
  rm "$old"
done

launchctl bootout "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || true
launchctl bootstrap "gui/$(id -u)" "$PLIST"
launchctl bootout "gui/$(id -u)/$API_LABEL" >/dev/null 2>&1 || true
launchctl bootstrap "gui/$(id -u)" "$API_PLIST"

for _ in {1..30}; do
  if curl --fail --silent "http://127.0.0.1:$PORT/health" >/dev/null &&
     curl --fail --silent "http://127.0.0.1:4388/health" >/dev/null &&
     launchctl list "$LABEL" | /usr/bin/grep -q '"PID" = ' &&
     launchctl list "$API_LABEL" | /usr/bin/grep -q '"PID" = '; then
    echo "Portfolio installed at http://127.0.0.1:$PORT with oncall at /oncall"
    echo "Oncall API and six-minute polling running at http://127.0.0.1:4388"
    echo "CLI commands installed in $HOME/bin"
    exit 0
  fi
  sleep 1
done

echo "portfolio install: API service did not become healthy; inspect $ROOT/logs/oncall-api-stderr.log" >&2
exit 1
