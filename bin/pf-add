#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/pf'
require_relative '../lib/pf/detect'
require_relative '../lib/pf/render'


Pf.run do
  add_option :type, short: 't', desc: 'override the detected type'
  add_option :tags, short: 'g', desc: 'comma-separated tags'
  add_option :title, desc: 'override the title'
  add_option :category, short: 'c', desc: 'category name for file/dir items'
  add_flag :open, short: 'o', desc: 'open the new item afterwards'
  add_flag :json, short: 'j', desc: 'print the created item as JSON'

  add_default do
    opts = options.select(%i[type tags title category open json]).parse(all_args)
    next puts(opts.help_text) if opts.help?
    raw = ((opts.args.length == 1 && opts.args[0] == '-') || opts.args.empty?) ? Pf.read_stdin : opts.args.join(' ')
    raise Pf::Error, 'nothing to add' if raw.strip.empty?

    detected = Pf::Detect.detect(raw)
    type = opts.type || detected['type']
    raise Pf::Error, "invalid type #{type}" unless Pf::ITEM_TYPES.include?(type)

    if %w[link pr].include?(type) && detected['shape'] != 'url'
      raise Pf::Error, "a #{type} needs a URL"
    elsif %w[file dir].include?(type) && detected['shape'] != 'path'
      raise Pf::Error, "a #{type} needs an absolute path"
    elsif type == 'document' && detected['shape'] == 'path' && !detected['exists']
      raise Pf::Error, 'that file does not exist yet'
    elsif !%w[link pr file dir document].include?(type) && detected['shape'] != 'text'
      raise Pf::Error, "a #{type} needs some text"
    end

    store = Pf.writable_store
    base = { 'title' => opts.title || detected['title'], 'description' => '', 'content' => '', 'rendered_html' => '', 'url' => nil, 'source_path' => nil, 'toc' => 1 }
    id = nil
    if %w[link pr].include?(type)
      id = store.upsert_item(base.merge('type' => type, 'url' => detected['url']))
    elsif %w[file dir].include?(type)
      raise Pf::Error, 'another item already tracks that path' if store.find_item_by_path(detected['path'])

      category = opts.category ? store.find_category(opts.category) : nil
      raise Pf::Error, "no category named #{opts.category}" if opts.category && !category
      raise Pf::Error, "category #{category['name']} holds #{category['kind']} items" if category && category['kind'] != type

      id = store.upsert_item(base.merge('type' => type))
      store.set_path_and_category(id, detected['path'], category&.fetch('id'))
    elsif type == 'document' && detected['shape'] == 'path'
      content = File.read(detected['path'], encoding: 'UTF-8')
      html = Pf::Detect.html_path?(detected['path'])
      title = opts.title || Pf::Detect.document_title(content, detected['path'])
      id = store.upsert_item(base.merge('type' => 'document', 'title' => title, 'content' => html ? '' : content, 'rendered_html' => html ? content : '', 'source_path' => detected['path']))
      unless html
        store.set_rendered_html(id, Pf::Render.render_markdown(content, title: title, source_path: detected['path'], resolve_id: ->(path) { store.find_item_by_source(path)&.fetch('id') }))
      end
      if html && !store.find_item_by_path(detected['path'])
        file_id = store.upsert_item('type' => 'file', 'title' => File.basename(detected['path']))
        store.set_path_and_category(file_id, detected['path'], nil)
      end
    else
      id = store.upsert_item(base.merge('type' => type, 'content' => detected['content'], 'rendered_html' => Pf::Render.render_markdown(detected['content'], title: base['title'])))
    end
    store.set_tags(id, Pf.parse_tags(opts.tags))
    item = store.get_item(id)
    href = Pf.item_url(item)
    if opts.json?
      puts Pf.json(store.view_item(item))
    else
      puts "added #{Pf.label(item)}  #{href}"
    end
    Pf.open_default(href) if opts.open?
  end
end
