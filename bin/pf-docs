#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/pf'
require_relative '../lib/pf/documents'

module PfDocs
  module_function

  IMPORT_OPTS = %i[recursive title desc toc no_toc open json].freeze

  def define_import_options(h)
    h.add_flag :recursive, short: 'r', desc: 'also import local Markdown linked from the roots'
    h.add_option :title, short: 't', desc: 'title for the first root'
    h.add_option :desc, short: 'd', desc: 'description for the first root'
    h.add_flag :toc, desc: 'include a table of contents (default)'
    h.add_flag :no_toc, long: 'no-toc', desc: 'omit the table of contents'
    h.add_flag :open, short: 'o', desc: 'open the roots afterwards'
    h.add_flag :json, short: 'j', desc: 'print JSON'
  end

  def print_add_result(result, opts)
    if opts.json?
      puts Pf.json('imported' => result['imported'], 'roots' => result['roots'])
    else
      puts "imported #{result['imported']} files"
      Array(result['roots']).each { |item| puts "saved #{Pf.item_url(item)}  #{Pf.abbreviate_path(item['source_path'])}" }
    end
    Array(result['roots']).each { |item| Pf.open_default(Pf.item_url(item)) } if opts.open?
  end


  def print_push_result(result, opts)
    if opts.json?
      puts Pf.json(result)
    else
      Array(result['items']).each { |item| puts "saved #{Pf.client.absolute(item['href'])}" }
    end
    Array(result['items']).each { |item| Pf.open_default(Pf.client.absolute(item['href'])) } if opts.open?
  end
end

Pf.run do
  PfDocs.define_import_options(self)

  add_cmd 'add', 'import', opts: PfDocs::IMPORT_OPTS do
    PfDocs.print_add_result(Pf::Documents.import_files(opts.args, opts), opts)
  end

  add_cmd 'push', opts: PfDocs::IMPORT_OPTS do
    PfDocs.print_push_result(Pf::Documents.push_files(opts.args, opts), opts)
  end

  add_cmd 'links', opts: %i[json] do
    raise Pf::Error, 'file required' unless opts.args[0]

    crawl = Pf::Crawl.crawl_markdown([opts.args[0]], recursive: true)
    if opts.json?
      puts Pf.json({ 'files' => crawl['files'], 'edges' => crawl['edges'] })
    else
      crawl['edges'].each do |from, to|
        puts Pf.abbreviate_path(from)
        to.each { |target| puts "  → #{Pf.abbreviate_path(target)}" }
      end
    end
  end

  add_flag :missing, short: 'm', desc: 'only those whose source is gone'
  add_cmd 'tracked', opts: %i[json missing] do
    store = Pf.store
    rows = []
    store.list_items('type' => 'document').each do |item|
      source = item['source_path']
      next unless source
      exists = File.exist?(source)
      next if opts.missing? && exists

      rows << { 'id' => item['id'], 'title' => item['title'], 'source' => Pf.abbreviate_path(source), 'exists' => exists ? 'yes' : 'MISSING' }
    end
    puts(opts.json? ? Pf.json(rows) : Pf.table(rows))
  end

  add_flag :disk, desc: 're-read the tracked source file first'
  add_flag :all, short: 'a', desc: 'every Markdown-backed document'
  add_cmd 'rerender', opts: %i[disk all] do
    puts "re-rendered #{Pf::Documents.rerender(opts.args, opts)} documents"
  end
end
