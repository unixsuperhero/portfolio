#!/usr/bin/env python3
"""Scan local TCP listeners and attribute them to processes, cwds, and Herdr panes.

Output (stdout) is JSON:
  {"scanned_at": iso, "herdr_available": bool, "ports": [...], "warnings": [...]}
Each port entry:
  {"port","host","proto","command","pid","user","cwd","ppid","command_line",
   "elapsed_secs","elapsed","started_at",
   "herdr": {"workspace_id","workspace_label","tab_id","pane_id","agent",
             "agent_status","agent_session","agent_session_source","cwd",
             "shell_pid","match"} | None,
   "ai": {"kind","session"} | None,
   "tree": [{"pid","ppid","command","cwd","ports","elapsed_secs","elapsed",
     "started_at"}] (listener first, walking up to init; cwd per ancestor,
     ports = its own open [{host,port}]),
   "children": [{"pid","ppid","command","cwd","elapsed_secs","elapsed",
     "started_at"}] (direct children of the listener)}

elapsed_secs is seconds since the process started (from `ps -o etime`);
elapsed is a short human form ("45s", "12m 03s", "4h 05m", "3d 2h");
started_at is the estimated ISO start time. All three are null/""/null
when ps reports nothing usable.

Herdr mapping: a listening PID is attributed to the pane whose shell_pid is
an ancestor of the PID (or equals it), falling back to cwd equality with the
pane foreground_cwd. Agent session comes from `herdr agent list`.
When Herdr is unavailable, ports/process/cwd are still reported and
`ai` falls back to a heuristic scan of the ancestor command lines.
"""
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timedelta, timezone

TIMEOUT = 8
AI_HINT_RE = re.compile(r"(codex|claude|muse|cursor|gemini|aider|copilot|opencode|omp)\b", re.I)


def parse_etime(value):
    """BSD/macOS `ps -o etime` ([D-]HH:MM:SS or MM:SS) -> seconds, or None."""
    text = (value or "").strip()
    days = 0
    if "-" in text:
        day_part, text = text.split("-", 1)
        try:
            days = int(day_part)
        except ValueError:
            return None
    try:
        nums = [int(part) for part in text.split(":")]
    except ValueError:
        return None
    if len(nums) == 2:
        return days * 86400 + nums[0] * 60 + nums[1]
    if len(nums) == 3:
        return days * 86400 + nums[0] * 3600 + nums[1] * 60 + nums[2]
    return None


def format_elapsed(secs):
    """Short human uptime: 45s, 12m 03s, 4h 05m, 3d 2h. Empty when unknown."""
    if secs is None:
        return ""
    mins, sec = divmod(secs, 60)
    if mins < 1:
        return f"{sec}s"
    if mins < 60:
        return f"{mins}m {sec:02d}s" if sec else f"{mins}m"
    hours, mins = divmod(mins, 60)
    if hours < 48:
        return f"{hours}h {mins:02d}m" if mins else f"{hours}h"
    days, hours = divmod(hours, 24)
    return f"{days}d {hours}h" if hours else f"{days}d"


def started_iso(now, secs):
    if secs is None:
        return None
    try:
        return (now - timedelta(seconds=secs)).isoformat()
    except (OverflowError, ValueError):
        return None


def run(cmd, timeout=TIMEOUT):
    try:
        result = subprocess.run(
            cmd, text=True, capture_output=True, timeout=timeout)
        return result.returncode, result.stdout, result.stderr
    except FileNotFoundError as error:
        return 127, "", str(error)
    except subprocess.TimeoutExpired:
        return 124, "", f"timed out: {' '.join(cmd)}"


def parse_listeners(warnings):
    code, out, err = run(["lsof", "-iTCP", "-sTCP:LISTEN", "-P", "-n"])
    if code != 0 or not out.strip():
        if err.strip():
            warnings.append(f"lsof: {err.strip().splitlines()[0][:200]}")
        else:
            warnings.append("lsof returned no listeners")
        return []
    entries = []
    for line in out.splitlines()[1:]:
        parts = line.split(None, 8)
        if len(parts) < 9:
            continue
        command, pid, user = parts[0], parts[1], parts[2]
        name = parts[8].strip()
        match = re.search(r"(\S+):(\d+)(?:\s+\(LISTEN\))?\s*$", name)
        if not match:
            continue
        try:
            pid_int = int(pid)
            port_int = int(match.group(2))
        except ValueError:
            continue
        entries.append({
            "host": match.group(1),
            "port": port_int,
            "proto": "TCP",
            "command": command,
            "pid": pid_int,
            "user": user,
        })
    # Dedupe exact (host, port, pid) repeats (e.g. IPv4/IPv6 double rows collapse naturally).
    seen = set()
    unique = []
    for entry in entries:
        key = (entry["host"], entry["port"], entry["pid"])
        if key in seen:
            continue
        seen.add(key)
        unique.append(entry)
    return sorted(unique, key=lambda e: (e["port"], e["host"], e["pid"]))


def process_details(pids, warnings):
    """Return ({pid: {ppid, command_line, elapsed_secs}}, {pid: ppid},
    {pid: command}, {pid: elapsed_secs})."""
    info = {}
    ancestry = {}
    commands = {}
    etimes = {}
    code, out, _ = run(["ps", "-ax", "-o", "pid,ppid,etime,command"])
    if code != 0 or not out.strip():
        warnings.append("ps ancestry scan failed")
        return info, ancestry, commands, etimes
    for line in out.splitlines()[1:]:
        parts = line.strip().split(None, 3)
        if len(parts) < 3:
            continue
        try:
            pid = int(parts[0])
            ppid = int(parts[1])
        except ValueError:
            continue
        secs = parse_etime(parts[2])
        cmd = parts[3] if len(parts) > 3 else ""
        ancestry[pid] = ppid
        commands[pid] = cmd
        etimes[pid] = secs
        if pid in pids:
            info[pid] = {"ppid": ppid, "command_line": cmd, "elapsed_secs": secs}
    return info, ancestry, commands, etimes


def pid_cwd(pid, warnings):
    code, out, _ = run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-F", "n"], timeout=4)
    if code == 0:
        for line in out.splitlines():
            if line.startswith("n/"):
                return line[1:]
    # Fallback: parse human-readable lsof output.
    code, out, _ = run(["lsof", "-p", str(pid)], timeout=4)
    if code == 0:
        for line in out.splitlines():
            if re.search(r"\bcwd\b", line):
                parts = line.split(None, 8)
                if len(parts) == 9 and parts[8].startswith("/"):
                    return parts[8]
    return ""


def batch_cwd(pids, warnings):
    """cwd for many pids in one lsof call: {pid: cwd}."""
    targets = sorted(set(pids))
    if not targets:
        return {}
    code, out, err = run(
        ["lsof", "-a", "-p", ",".join(map(str, targets)), "-d", "cwd", "-F", "pn"],
        timeout=8,
    )
    result = {}
    current = None
    for line in out.splitlines():
        if line.startswith("p"):
            try:
                current = int(line[1:])
            except ValueError:
                current = None
        elif line.startswith("n/") and current is not None:
            result[current] = line[1:]
            current = None
    if code != 0 and not result:
        # A pid that exited mid-scan can poison the whole batch; only warn
        # when nothing at all came back.
        detail = (err or "").strip().splitlines()
        warnings.append(f"lsof batch cwd: {detail[0][:160] if detail else 'no output'}")
    return result


HERDR_FALLBACKS = ["~/.local/bin/herdr", "/opt/homebrew/bin/herdr", "/usr/local/bin/herdr"]
_HERDR_BIN = "herdr"


def resolve_herdr_bin():
    """herdr binary: HERDR_BIN override, then PATH, then common locations."""
    override = os.environ.get("HERDR_BIN")
    if override:
        return override
    found = shutil.which("herdr")
    if found:
        return found
    for candidate in HERDR_FALLBACKS:
        path = os.path.expanduser(candidate)
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


def herdr_json(args, warnings):
    code, out, err = run([_HERDR_BIN, *args], timeout=TIMEOUT)
    if code != 0:
        detail = (err or out).strip().splitlines()
        if detail:
            warnings.append(f"herdr {' '.join(args[:2])}: {detail[0][:160]}")
        return None
    try:
        return json.loads(out)
    except (json.JSONDecodeError, ValueError):
        warnings.append(f"herdr {' '.join(args[:2])}: unparseable output")
        return None


def unwrap(payload):
    if isinstance(payload, dict) and isinstance(payload.get("result"), dict):
        return payload["result"]
    return payload if isinstance(payload, dict) else {}


def collect_herdr(warnings):
    """Return (panes, agents, shell_pid->pane, available)."""
    global _HERDR_BIN
    resolved = resolve_herdr_bin()
    if resolved is None and not os.environ.get("HERDR_SOCKET_PATH"):
        warnings.append("herdr CLI not found (looked for 'herdr' on PATH, HERDR_BIN, and ~/.local/bin); port ownership falls back to process data")
        return [], [], {}, False
    _HERDR_BIN = resolved or "herdr"
    workspaces_doc = herdr_json(["workspace", "list"], warnings)
    workspaces = unwrap(workspaces_doc).get("workspaces", [])
    if workspaces_doc is None:
        warnings.append("herdr unavailable; port ownership falls back to process data")
        return [], [], {}, False
    panes = []
    labels = {w.get("workspace_id"): w.get("label", "") for w in workspaces if w.get("workspace_id")}
    for workspace in workspaces:
        wid = workspace.get("workspace_id")
        if not wid:
            continue
        doc = herdr_json(["pane", "list", "--workspace", wid], warnings)
        for pane in unwrap(doc).get("panes", []):
            pane["_workspace_label"] = labels.get(wid, "")
            panes.append(pane)
    agents_doc = herdr_json(["agent", "list"], warnings)
    agents = unwrap(agents_doc).get("agents", [])
    shell_map = {}
    for pane in panes:
        pane_id = pane.get("pane_id")
        if not pane_id:
            continue
        doc = herdr_json(["pane", "process-info", "--pane", pane_id], warnings)
        info = unwrap(doc).get("process_info", {})
        shell_pid = info.get("shell_pid")
        if isinstance(shell_pid, int):
            shell_map[shell_pid] = pane
        # Keep foreground pids for direct-match fallback.
        pane["_shell_pid"] = shell_pid if isinstance(shell_pid, int) else None
        pane["_fg_pids"] = [p.get("pid") for p in info.get("foreground_processes", [])
                            if isinstance(p.get("pid"), int)]
    return panes, agents, shell_map, True


def ancestors(pid, ancestry):
    chain = []
    seen = set()
    current = pid
    while current and current not in seen and len(chain) < 64:
        seen.add(current)
        parent = ancestry.get(current)
        if not parent:
            break
        chain.append(parent)
        current = parent
    return chain


def attribute(pid, cwd, panes, agents, shell_map, ancestry):
    chain = set(ancestors(pid, ancestry)) | {pid}
    for shell_pid, pane in shell_map.items():
        if shell_pid in chain:
            herdr, ai = pane_match(pane, agents)
            herdr["match"] = "process"
            return herdr, ai
    for pane in panes:
        if pid in (pane.get("_fg_pids") or []):
            herdr, ai = pane_match(pane, agents)
            herdr["match"] = "process"
            return herdr, ai
    if cwd:
        for pane in panes:
            if cwd == pane.get("foreground_cwd") or cwd == pane.get("cwd"):
                herdr, ai = pane_match(pane, agents)
                herdr["match"] = "cwd"
                return herdr, ai
    return None


def pane_match(pane, agents):
    pane_id = pane.get("pane_id")
    agent_entry = next((a for a in agents if a.get("pane_id") == pane_id), None)
    agent = (agent_entry or {}).get("agent") or pane.get("agent")
    session = (agent_entry or {}).get("agent_session") or pane.get("agent_session") or {}
    if isinstance(session, dict):
        session_value = session.get("value")
        session_source = session.get("source")
        session_agent = session.get("agent") or agent
    else:
        session_value = str(session) if session else None
        session_source = None
        session_agent = agent
    herdr = {
        "workspace_id": pane.get("workspace_id"),
        "workspace_label": pane.get("_workspace_label", ""),
        "tab_id": pane.get("tab_id"),
        "pane_id": pane_id,
        "shell_pid": pane.get("_shell_pid"),
        "agent": agent,
        "agent_status": (agent_entry or {}).get("agent_status") or pane.get("agent_status"),
        "cwd": pane.get("cwd"),
        "foreground_cwd": pane.get("foreground_cwd"),
    }
    ai = None
    if session_value or session_agent:
        ai = {"kind": session_agent, "session": session_value,
              "source": session_source or "herdr"}
    return herdr, ai


def ai_fallback(pid, ancestry, commands):
    """Heuristic AI-session hint from ancestor command lines when Herdr has no match."""
    current = pid
    seen = set()
    while current and current not in seen and len(seen) < 64:
        seen.add(current)
        cmdline = commands.get(current, "")
        if cmdline:
            first = cmdline.split()[0] if cmdline.split() else ""
            match = AI_HINT_RE.search(os.path.basename(first) + " " + cmdline)
            if match:
                return {"kind": match.group(1).lower(), "session": None,
                        "source": "process-heuristic",
                        "hint": cmdline[:300]}
        current = ancestry.get(current)
        if not current or current <= 1:
            break
    return None


def uptime_fields(now, secs):
    return {
        "elapsed_secs": secs,
        "elapsed": format_elapsed(secs),
        "started_at": started_iso(now, secs),
    }


def process_tree(pid, ancestry, commands, etimes, now):
    """Walk pid up to init: [{pid, ppid, command, ...uptime}], listener first."""
    chain = []
    seen = set()
    current = pid
    while current and current not in seen and len(chain) < 64:
        seen.add(current)
        ppid = ancestry.get(current)
        chain.append({
            "pid": current,
            "ppid": ppid,
            "command": commands.get(current, ""),
            **uptime_fields(now, etimes.get(current)),
        })
        if not ppid or ppid == current:
            break
        current = ppid
    return chain


def direct_children(pid, ancestry, commands, etimes, now):
    """Direct children of pid: [{pid, ppid, command, ...uptime}] sorted by pid."""
    return sorted(
        ({"pid": child, "ppid": pid, "command": commands.get(child, ""),
          **uptime_fields(now, etimes.get(child))}
         for child, parent in ancestry.items() if parent == pid),
        key=lambda e: e["pid"],
    )


def main():
    warnings = []
    listeners = parse_listeners(warnings)
    pids = {e["pid"] for e in listeners}
    details, ancestry, commands, etimes = process_details(pids, warnings)
    panes, agents, shell_map, herdr_available = collect_herdr(warnings)
    cws = {}
    for pid in pids:
        cws[pid] = pid_cwd(pid, warnings)
    now = datetime.now(timezone.utc)
    ports = []
    for entry in listeners:
        pid = entry["pid"]
        detail = details.get(pid, {})
        cwd = cws.get(pid, "")
        herdr = None
        ai = None
        if herdr_available:
            matched = attribute(pid, cwd, panes, agents, shell_map, ancestry)
            if matched:
                herdr, ai = matched
        if ai is None:
            ai = ai_fallback(pid, ancestry, commands)
        ports.append({
            **entry,
            "cwd": cwd,
            "ppid": detail.get("ppid"),
            "command_line": detail.get("command_line", ""),
            **uptime_fields(now, detail.get("elapsed_secs")),
            "herdr": herdr,
            "ai": ai,
            "tree": process_tree(pid, ancestry, commands, etimes, now),
            "children": direct_children(pid, ancestry, commands, etimes, now),
        })
    pid_ports = {}
    for item in ports:
        pid_ports.setdefault(item["pid"], []).append({"host": item["host"], "port": item["port"]})
    tree_pids = set()
    for item in ports:
        for node in item["tree"]:
            tree_pids.add(node["pid"])
        for child in item["children"]:
            tree_pids.add(child["pid"])
    known_cwds = {item["pid"]: item["cwd"] for item in ports if item["cwd"]}
    fetched = batch_cwd(tree_pids - set(known_cwds), warnings)
    cwd_of = {**fetched, **known_cwds}
    for item in ports:
        for node in item["tree"]:
            node["cwd"] = cwd_of.get(node["pid"], "")
            node["ports"] = pid_ports.get(node["pid"], [])
        for child in item["children"]:
            child["cwd"] = cwd_of.get(child["pid"], "")
    payload = {
        "scanned_at": now.isoformat(),
        "herdr_available": herdr_available,
        "ports": ports,
        "warnings": sorted(set(warnings)),
    }
    json.dump(payload, sys.stdout, indent=2)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
