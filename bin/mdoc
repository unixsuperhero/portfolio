#!/usr/bin/env bash
set -euo pipefail

SERVER="${MDOC_SERVER:-http://127.0.0.1:4387}"
TITLE="" DESC="" TOC=true OPEN=true RECURSIVE=false REBUILD=false OUT="" COMBINED=false
TEMP="" TEMP_BASE="" INPUTS=()
trap '[[ -n "$TEMP" ]] && rm -f "$TEMP"; [[ -n "$TEMP_BASE" ]] && rm -f "$TEMP_BASE"' EXIT

usage() {
  cat <<'EOF'
mdoc — add Markdown or HTML to the local Portfolio server

Usage:
  mdoc <file.md|file.html> [more-files...] [-r|--recursive] [-t|--title TITLE] [-d|--desc DESCRIPTION]
  echo '# Hello' | mdoc - --title 'Piped input'

One Markdown file is stored on the Portfolio server. HTML files are stored
as-is. Multiple Markdown files, or -r, produce one standalone HTML file
with embedded resources, saved as one library item. Roots appear in input
order; recursively discovered files follow. Links between included documents
stay inside the combined HTML. --out names a new HTML file; otherwise a
temporary output file is retained. Recursive link-following is Markdown only.

Options:
  -t, --title <text>  Override the first root title
  -d, --desc <text>   Set the first root description
  -o, --out <file>    Standalone HTML output (must not exist yet)
      --toc           Include a table of contents (default)
      --no-toc        Omit the table of contents
      --no-open       Do not open the saved item
  -r, --recursive     Follow local Markdown links; build one HTML file
      --no-date       Accepted for compatibility
      --rebuild-index Verify the server and search index
  -h, --help          Show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -t|--title) TITLE="$2"; shift 2 ;;
    -d|--desc) DESC="$2"; shift 2 ;;
    --toc) TOC=true; shift ;;
    --no-toc) TOC=false; shift ;;
    --no-open) OPEN=false; shift ;;
    -o|--out) OUT="$2"; shift 2 ;;
    -r|--recursive) RECURSIVE=true; shift ;;
    --no-date) shift ;;
    --rebuild-index) REBUILD=true; shift ;;
    --) shift; INPUTS+=("$@"); break ;;
    -) INPUTS+=("$1"); shift ;;
    -*) echo "mdoc: unknown flag: $1" >&2; exit 1 ;;
    *) INPUTS+=("$1"); shift ;;
  esac
done

if [[ "$REBUILD" == true ]]; then
  curl --fail --silent --show-error "$SERVER/health"
  echo
  exit 0
fi
[[ ${#INPUTS[@]} -gt 0 ]] || { usage >&2; exit 1; }

for index in "${!INPUTS[@]}"; do
  if [[ "${INPUTS[$index]}" == "-" ]]; then
    [[ "$RECURSIVE" == false ]] || { echo "mdoc: --recursive is not supported with stdin" >&2; exit 1; }
    [[ -z "$TEMP" ]] || { echo "mdoc: stdin can appear once" >&2; exit 1; }
    TEMP_BASE=$(mktemp -t mdoc-stdin)
    TEMP="$TEMP_BASE.md"
    mv "$TEMP_BASE" "$TEMP"
    TEMP_BASE=""
    cat > "$TEMP"
    INPUTS[$index]="$TEMP"
  fi
  INPUTS[$index]=$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "${INPUTS[$index]}")
  [[ -f "${INPUTS[$index]}" ]] || { echo "mdoc: not found: ${INPUTS[$index]}" >&2; exit 1; }
done

FILES_JSON=$(python3 - "$RECURSIVE" "${INPUTS[@]}" <<'PY'
from collections import deque
import json
import os
import subprocess
import sys
from pathlib import Path
from urllib.parse import unquote

reader = 'markdown+lists_without_preceding_blankline-blank_before_header-blank_before_blockquote+autolink_bare_uris+emoji+mark+wikilinks_title_before_pipe'
recursive = sys.argv[1] == 'true'
roots = [os.path.normpath(os.path.abspath(path)) for path in sys.argv[2:]]

def local_markdown_link(source, target):
    if not target or target.startswith(('#', '//')):
        return None
    if ':' in target.split('/', 1)[0]:
        return None
    boundary = min((index for index in (target.find('?'), target.find('#')) if index >= 0), default=-1)
    encoded_path = target if boundary < 0 else target[:boundary]
    if not encoded_path:
        return None
    path = unquote(encoded_path)
    if Path(path).suffix.lower() not in {'.md', '.markdown'}:
        return None
    return os.path.normpath(os.path.abspath(os.path.join(os.path.dirname(source), path)))

def links(value):
    if isinstance(value, dict):
        if value.get('t') == 'Link':
            content = value.get('c', [])
            if len(content) > 2 and isinstance(content[2], list) and content[2]:
                yield content[2][0]
        for child in value.values():
            yield from links(child)
    elif isinstance(value, list):
        for child in value:
            yield from links(child)

def document_links(path):
    result = subprocess.run(['pandoc', '--from=' + reader, '--to=json', path], text=True, capture_output=True)
    if result.returncode:
        raise SystemExit(result.stderr.strip() or 'mdoc: pandoc failed')
    return links(json.loads(result.stdout))

seen = set()
queue = deque(roots)
ordered = []
while queue:
    path = queue.popleft()
    if path in seen:
        continue
    if not os.path.isfile(path):
        raise SystemExit(f'mdoc: linked Markdown not found: {path}')
    seen.add(path)
    ordered.append(path)
    if not recursive:
        continue
    if Path(path).suffix.lower() not in {'.md', '.markdown'}:
        continue
    for target in document_links(path):
        child = local_markdown_link(path, target)
        if child and not os.path.isfile(child):
            raise SystemExit(f'mdoc: linked Markdown not found: {child} (from {path})')
        if child and child not in seen:
            queue.append(child)

print(json.dumps({'roots': roots, 'files': ordered}))
PY
)

FILES=()
while IFS= read -r file; do
  [[ -n "$file" ]] && FILES+=("$file")
done < <(python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["files"]))' <<<"$FILES_JSON")

if [[ -n "$OUT" ]]; then
  OUT=$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$OUT")
fi

ALL_MD=true
for file in "${FILES[@]}"; do
  ext=$(printf '%s' "${file##*.}" | tr '[:upper:]' '[:lower:]')
  [[ "$ext" == "md" || "$ext" == "markdown" ]] || ALL_MD=false
done
if [[ "$ALL_MD" == true && ( "$RECURSIVE" == true || ${#FILES[@]} -gt 1 ) ]]; then
  COMBINED=true
fi
if [[ -n "$OUT" && "$COMBINED" == false ]]; then
  echo "mdoc: --out is for multiple Markdown files or -r" >&2
  exit 1
fi

if [[ "$COMBINED" == true ]]; then
  HTML_OUT=$(python3 - "$OUT" "$TITLE" "$TOC" "${FILES[@]}" <<'PY'
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path
from urllib.parse import unquote, urlsplit

reader = 'markdown+lists_without_preceding_blankline-blank_before_header-blank_before_blockquote+autolink_bare_uris+emoji+mark+wikilinks_title_before_pipe'
out_arg, title, toc_flag = sys.argv[1:4]
files = sys.argv[4:]
if out_arg and os.path.lexists(out_arg):
    raise SystemExit(f'mdoc: output file already exists: {out_arg}')

def nodes(value):
    if isinstance(value, dict):
        if 't' in value:
            yield value
        for child in value.values():
            yield from nodes(child)
    elif isinstance(value, list):
        for child in value:
            yield from nodes(child)

def attribute(node):
    if node['t'] == 'Header':
        return node['c'][1]
    if node['t'] in {'CodeBlock', 'Code', 'Div', 'Span', 'Link', 'Image', 'Table', 'Figure'}:
        return node['c'][0]

documents = {}
ids = {}
starts = {}
for index, path in enumerate(files, 1):
    result = subprocess.run(['pandoc', '--from=' + reader, '--to=json', path], text=True, capture_output=True)
    if result.returncode:
        raise SystemExit(result.stderr.strip() or 'mdoc: pandoc failed')
    documents[path] = json.loads(result.stdout)
    prefix = f'mdoc-{index}'
    ids[path] = {}
    starts[path] = prefix
    for node in nodes(documents[path]['blocks']):
        attr = attribute(node)
        if attr and attr[0]:
            old = attr[0]
            attr[0] = f'{prefix}-{old}'
            ids[path][old] = attr[0]
            if node['t'] == 'Header' and starts[path] == prefix:
                starts[path] = attr[0]

def anchor(path, fragment):
    fragment = unquote(fragment)
    if fragment in ids[path]:
        return ids[path][fragment]
    folded = [value for key, value in ids[path].items() if key.lower() == fragment.lower()]
    return folded[0] if len(folded) == 1 else starts[path]

blocks = []
for index, path in enumerate(files, 1):
    document = documents[path]
    for node in nodes(document['blocks']):
        if node['t'] not in {'Link', 'Image'}:
            continue
        target = node['c'][2][0]
        url = urlsplit(target)
        if url.scheme or url.netloc:
            continue
        resolved = os.path.normpath(os.path.join(os.path.dirname(path), unquote(url.path))) if url.path else path
        if node['t'] == 'Link' and resolved in documents:
            node['c'][2][0] = '#' + anchor(resolved, url.fragment)
        elif node['t'] == 'Image' and url.path:
            node['c'][2][0] = Path(resolved).as_uri() + ('#' + url.fragment if url.fragment else '')
    blocks.append({'t': 'Div', 'c': [[f'mdoc-{index}', [], []], document['blocks']]})

combined = dict(documents[files[0]], blocks=blocks)
command = ['pandoc', '--from=json', '--to=html5', '--standalone', '--embed-resources', '--fail-if-warnings']
if toc_flag == 'true':
    command.append('--toc')
if title:
    command.extend(['--metadata', f'title={title}'])
command.extend(['--metadata', f'pagetitle={title or Path(files[0]).stem}'])
result = subprocess.run(command, input=json.dumps(combined), text=True, capture_output=True)
if result.returncode:
    raise SystemExit(result.stderr.strip() or 'mdoc: pandoc failed')
if out_arg:
    with open(out_arg, 'x') as output:
        output.write(result.stdout)
else:
    with tempfile.NamedTemporaryFile(mode='w', prefix='mdoc-', suffix='.html', delete=False) as output:
        output.write(result.stdout)
        out_arg = output.name
print(out_arg)
PY
)
  echo "mdoc: html $HTML_OUT"
  FILES=("$HTML_OUT")
  ROOTS_JSON=$(python3 -c 'import json,sys; print(json.dumps([sys.argv[1]]))' "$HTML_OUT")
else
  ROOTS_JSON=$(python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin)["roots"]))' <<<"$FILES_JSON")
fi

CURL_ARGS=(--form-string "roots=$ROOTS_JSON" --form-string "title=$TITLE" --form-string "description=$DESC" --form-string "toc=$TOC")
for file in "${FILES[@]}"; do
  escaped_file=${file//\\/\\\\}
  escaped_file=${escaped_file//\"/\\\"}
  CURL_ARGS+=(-F "file=@\"$escaped_file\"" --form-string "source_path=$file")
done
RESPONSE=$(curl --fail --silent --show-error "${CURL_ARGS[@]}" "$SERVER/api/documents")
HREFS=()
while IFS= read -r href; do
  [[ -n "$href" ]] && HREFS+=("$href")
done < <(python3 -c 'import json,sys; print("\n".join(item["href"] for item in json.load(sys.stdin)["items"]))' <<<"$RESPONSE")

for href in "${HREFS[@]}"; do
  url="$SERVER$href"
  echo "mdoc: saved $url"
  [[ "$OPEN" == false ]] || open "$url"
done
