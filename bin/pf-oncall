#!/usr/bin/env bun
import { OncallApi } from "../packages/oncall-mcp/src/client.ts";
import type { OncallItemStatus } from "../packages/oncall-mcp/src/client.ts";

const api = new OncallApi();
const [command, ...args] = process.argv.slice(2);
const statuses = new Set<OncallItemStatus>(["open", "working", "blocked", "done", "dismissed"]);
const usage = `Usage: pf-oncall COMMAND [ARGS]
  list [all|open|working|blocked|done|dismissed]   List oncall items
  add TITLE [BODY]                                Add an action item
  status ID open|working|blocked|done|dismissed|auto
                                                  Set or clear a manual status
  prompts                                         List prompts and workspaces
  run PROMPT_ID                                   Run and print captured output
  runs [RUN_ID]                                   List runs or print one response`;

async function main(): Promise<void> {
  switch (command) {
    case "list": {
      const filter = args[0] ?? "all";
      if (filter !== "all" && !statuses.has(filter as OncallItemStatus)) throw new Error(`Unknown status: ${filter}`);
      const board = await api.board();
      if (board.polling_error) console.error(`Poll error: ${board.polling_error}`);
      for (const item of board.items) {
        if (filter !== "all" && item.status !== filter) continue;
        console.log(`${item.id}\t${item.status}\t${item.kind}\t${item.title}\t${item.slack_message_url ?? item.pr_url ?? ""}`);
      }
      break;
    }
    case "add": {
      if (!args[0]) throw new Error("Add requires a title");
      const item = await api.createItem({ title: args[0], body: args[1] });
      console.log(`${item.id}\t${item.status}\t${item.title}`);
      break;
    }
    case "status": {
      const id = Number(args[0]);
      const value = args[1];
      if (!Number.isSafeInteger(id) || id < 1 || !value || (value !== "auto" && !statuses.has(value as OncallItemStatus))) {
        throw new Error("Status requires a valid item ID and open, working, blocked, done, dismissed, or auto");
      }
      const item = await api.setStatus(id, value === "auto" ? null : value as OncallItemStatus);
      console.log(`${item.id}\t${item.status}\t${item.title}`);
      break;
    }
    case "prompts": {
      const board = await api.board();
      for (const prompt of board.prompts) console.log(`${prompt.id}\t${prompt.title}\t${prompt.directory}`);
      break;
    }
    case "run": {
      if (!args[0]) throw new Error("Run requires a prompt ID");
      let run = await api.runPrompt(args[0]);
      console.log(`Run ${run.id}: ${run.status}`);
      while (run.status === "running") {
        await Bun.sleep(2000);
        run = await api.run(run.id);
      }
      if (run.output) console.log(run.output);
      if (run.status === "failed") process.exitCode = 1;
      break;
    }
    case "runs": {
      if (args[0]) {
        const run = await api.run(Number(args[0]));
        console.log(`${run.id}\t${run.status}\t${run.prompt_id}\n${run.output}`);
      } else {
        for (const run of await api.runs()) console.log(`${run.id}\t${run.status}\t${run.prompt_id}\t${run.started_at}`);
      }
      break;
    }
    case "-h":
    case "--help":
    case undefined:
      console.log(usage);
      break;
    default:
      throw new Error(`Unknown command: ${command}\n${usage}`);
  }
}

try { await main(); }
catch (error) { console.error(`pf-oncall: ${(error as Error).message}`); process.exitCode = 1; }
