#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/pf"
require_relative "../lib/pf/ports"

Pf.run do
  add_flag :json, short: "j", desc: "print the scanner JSON"
  add_option :port, short: "p", type: :integer, desc: "only this port"
  add_option :pid, type: :integer, desc: "kill by pid instead"
  add_flag :kill, short: "9", desc: "send SIGKILL"

  add_cmd :ls, :list, opts: [:json, :port] do
    snap = Pf::Ports.scan
    if opts.json?
      puts Pf.json(snap)
    else
      puts "scan error: #{snap["error"]}" if snap["error"]
      shown = opts.port ? snap.merge("ports" => Pf::Ports.find_by_port(snap, opts.port)) : snap
      puts Pf.table(Pf::Ports.rows(shown))
      puts "(Herdr unavailable: pane and session columns come from heuristics)" unless snap["herdr_available"]
    end
  end

  add_cmd :tree, args: ["PORT"] do
    port = Pf.number_arg(opts.args[0], "port")
    snap = Pf::Ports.scan
    entry = Pf::Ports.find_by_port(snap, port).first
    raise Pf::Error, "nothing listens on #{opts.args[0]}" unless entry
    puts "#{Pf::Ports.site_url(entry)}  #{entry["command"]} ##{entry["pid"]}  #{entry["cwd"]}"
    puts Pf.json({ "herdr" => entry["herdr"], "ai" => entry["ai"], "tree" => entry["tree"] || [], "children" => entry["children"] || [] })
  end

  add_cmd :open, args: ["PORT"] do
    port = Pf.number_arg(opts.args[0], "port")
    Pf.open_default(Pf::Ports.site_url({ host: "localhost", port: port }))
  end

  add_cmd :kill, args: ["PORT"], opts: [:pid, :kill] do
    snap = Pf::Ports.scan
    pid = opts.pid || Pf::Ports.find_by_port(snap, Pf.number_arg(opts.args[0], "port")).first&.fetch("pid", nil)
    raise Pf::Error, "no such listener" unless pid
    signal = opts.kill? ? "KILL" : "TERM"
    result = Pf::Ports.kill_listener(pid, signal: signal, snapshot: snap)
    puts "#{result["message"]}#{result["ok"] ? " (#{result["signal"]} → #{pid})" : ""}"
    result["ok"]
  end

  add_cmd :which do
    puts Pf::Ports.scanner_bin
  end
end
