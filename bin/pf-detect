#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/pf'
require_relative '../lib/pf/detect'

Pf.run do
  add_flag :json, short: 'j', desc: 'print JSON (default when not a TTY)'
  add_flag :type, short: 't', desc: 'print only the type'

  add_default do
    opts = options.select(%i[json type]).parse(all_args)
    next puts(opts.help_text) if opts.help?
    raw = opts.args.any? ? opts.args.join(' ') : Pf.read_stdin
    detected = Pf::Detect.detect(raw)
    if opts.type?
      puts detected['type']
    elsif opts.json? || !STDOUT.tty?
      puts Pf.json(detected)
    else
      puts "#{detected['type'].upcase}  #{detected['title']}"
      puts "url:    #{detected['url']}" if detected['url']
      puts "path:   #{detected['path']}#{detected['exists'] ? '' : '  (does not exist yet)'}" if detected['path']
    end
  end
end
