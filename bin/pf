#!/usr/bin/env ruby
# pf — the Portfolio toolbox. Every pf-* executable in this directory is a subcommand.
require_relative '../lib/pf'

Pf.run do
  tools = {}
  [__dir__, *ENV.fetch('PATH', '').split(File::PATH_SEPARATOR)].uniq.each do |directory|
    Dir.glob(File.join(directory, 'pf-*')).sort.each do |path|
      tools[File.basename(path).delete_prefix('pf-')] ||= path if File.file?(path) && File.executable?(path)
    end
  end
  tools.each { |name, path| add_cmd(name, passthrough: true) { exec(path, *args) } }
  add_cmd(:root) { puts Pf.project_root }
  add_cmd(:'db-path') { puts Pf.database_path }
  add_cmd(:tools) { runners.subcommand_names.map(&:to_s).sort.each { |name| puts "pf #{name}" } }
end
