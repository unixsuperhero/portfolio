#!/usr/bin/env bun
// pf-cards — cards are saved queries: tags OR-ed, types narrowing, sorted, capped.
import { cli, flag, json, numberArg, option, table, CliError } from "@portfolio/cli-kit";
import { openDefaultStore } from "@portfolio/cli";
import { describeCard, normalizeCard } from "@portfolio/core";
import type { Store } from "@portfolio/db";

const CARD_OPTS = {
  tags: option("g", "comma-separated tags; an item matches with any one"),
  types: option("t", "comma-separated types to narrow to (document,note,link,pr,file,dir)"),
  sort: option("s", "created_at | updated_at | title | type"),
  dir: option("d", "asc | desc"),
  max: option("m", "max items, 1-1000", { type: "number" }),
};
type CardOpts = { tags: string | null; types: string | null; sort: string | null; dir: string | null; max: number | null };
const inputFrom = (title: string | undefined, opts: CardOpts) => ({ title, tags: opts.tags ?? undefined, types: opts.types ?? undefined, sort_key: opts.sort ?? undefined, sort_dir: opts.dir ?? undefined, max_items: opts.max ?? undefined });
const portfolioOf = (store: Store, word: string | undefined) => {
  const found = word && /^\d+$/.test(word) ? store.portfolios.getPortfolio(Number(word)) : word ? store.portfolios.findPortfolio(word) : null;
  if (!found) throw new CliError(`no portfolio ${word ?? "(missing)"}; run pf-portfolios ls`);
  return found;
};

cli("pf-cards", c => {
  c.cmd(["ls", "list"], { desc: "cards of a portfolio", args: ["PORTFOLIO"], opts: { json: flag("j", "print JSON") } }, ({ args, opts, out }) => {
    const store = openDefaultStore({ readonly: true });
    const cards = store.portfolios.portfolioCards(portfolioOf(store, args[0]).id);
    out(opts.json ? json(cards) : table(cards.map(card => ({ id: card.id, pos: card.position, title: card.title, query: describeCard(card) }))));
  });

  c.cmd(["show", "run"], { desc: "run a card's query and list what it matches", args: ["CARD_ID"], opts: { json: flag("j", "print JSON") } }, ({ args, opts, out }) => {
    const store = openDefaultStore({ readonly: true });
    const card = store.portfolios.getCard(numberArg(args[0], "card id"));
    if (!card) throw new CliError("no such card");
    const result = store.portfolios.cardItems(card);
    if (opts.json) return out(json({ ...card, ...result }));
    out(`${card.title}  ${describeCard(card)}  (${result.items.length}${result.total > result.items.length ? ` of ${result.total}` : ""})`);
    for (const item of result.items) out(`  ${item.title} [${item.type} #${item.id}]`);
  });

  c.cmd(["preview", "query"], { desc: "run an unsaved card query from options, without touching any portfolio", opts: { ...CARD_OPTS, json: flag("j", "print JSON") } }, ({ opts, out }) => {
    const store = openDefaultStore({ readonly: true });
    const spec = normalizeCard(inputFrom("preview", opts));
    const result = store.portfolios.cardItems(spec);
    if (opts.json) return out(json({ ...spec, ...result }));
    out(`${describeCard(spec)}  (${result.items.length}${result.total > result.items.length ? ` of ${result.total}` : ""})`);
    for (const item of result.items) out(`  ${item.title} [${item.type} #${item.id}]`);
  });

  c.cmd(["add", "new"], { desc: "add a card to a portfolio", args: ["PORTFOLIO", "TITLE"], opts: CARD_OPTS }, ({ args, opts, out }) => {
    const store = openDefaultStore();
    const portfolio = portfolioOf(store, args[0]);
    out(`created card #${store.portfolios.createCard(portfolio.id, inputFrom(args.slice(1).join(" "), opts))} in ${portfolio.name}`);
  });

  c.cmd(["edit", "set"], { desc: "change a card's title or query; only given options change", args: ["CARD_ID", "TITLE..."], opts: CARD_OPTS }, ({ args, opts, out }) => {
    const store = openDefaultStore();
    const id = numberArg(args[0], "card id");
    const patch = Object.fromEntries(Object.entries(inputFrom(args.slice(1).join(" ") || undefined, opts)).filter(([, value]) => value !== undefined));
    if (!store.portfolios.updateCard(id, patch)) throw new CliError("no such card");
    out(`updated card #${id}: ${describeCard(store.portfolios.getCard(id)!)}`);
  });

  c.cmd("move", { desc: "move a card earlier (left) or later (right)", args: ["CARD_ID", "left|right"] }, ({ args, out }) => {
    const store = openDefaultStore();
    const card = store.portfolios.getCard(numberArg(args[0], "card id"));
    if (!card) throw new CliError("no such card");
    const direction = args[1] === "left" ? "left" : args[1] === "right" ? "right" : null;
    if (!direction) throw new CliError("direction must be left or right");
    out(store.portfolios.moveCard(card, direction) ? "moved" : "already at the edge");
  });

  c.cmd(["rm", "remove", "delete"], { desc: "delete a card; items are kept", args: ["CARD_ID"] }, ({ args, out }) => {
    const store = openDefaultStore();
    out(store.portfolios.deleteCard(numberArg(args[0], "card id")) ? "deleted" : "no such card");
  });
}, { desc: "cards: saved queries inside portfolios" }).run();
