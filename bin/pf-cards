#!/usr/bin/env ruby
# pf-cards — cards are saved queries: tags OR-ed, types narrowing, sorted, capped.
require_relative "../lib/pf"
require_relative "../lib/pf/cards"

module PfCards
  module_function

  def portfolio_of(store, word)
    found = if word&.match?(/^\d+$/)
      store.get_portfolio(word.to_i)
    elsif word
      store.find_portfolio(word)
    end
    raise Pf::Error, "no portfolio #{word || "(missing)"}; run pf-portfolios ls" unless found
    found
  end

  def card_options(hiiro)
    hiiro.add_option :tags, short: "g", desc: "comma-separated tags; an item matches with any one"
    hiiro.add_option :types, short: "t", desc: "comma-separated types to narrow to (#{Pf::ITEM_TYPES.join(",")})"
    hiiro.add_option :sort, short: "s", desc: "created_at | updated_at | title | type"
    hiiro.add_option :dir, short: "d", desc: "asc | desc"
    hiiro.add_option :max, short: "m", type: :integer, desc: "max items, 1-1000"
    %i[tags types sort dir max]
  end

  def input_from(title, opts)
    values = opts.to_h
    { "title" => title, "tags" => values[:tags], "types" => values[:types], "sort_key" => values[:sort], "sort_dir" => values[:dir], "max_items" => values[:max] }.reject { |_key, value| value.nil? }
  end

  def print_card_result(card, result)
    total = result["total"].to_i
    items = result["items"] || []
    suffix = total > items.length ? " of #{total}" : ""
    puts "#{card["title"]}  #{Pf::Cards.describe(card)}  (#{items.length}#{suffix})"
    items.each { |item| puts "  #{item["title"]} [#{item["type"]} ##{item["id"]}]" }
  end
end

Pf.run do |hiiro|
  card_opts = PfCards.card_options(hiiro)
  hiiro.add_flag :json, short: "j", desc: "print JSON"

  hiiro.add_cmd :ls, :list, args: ["PORTFOLIO"], opts: [:json] do
    store = Pf.store
    cards = store.portfolio_cards(PfCards.portfolio_of(store, opts.args[0])["id"])
    puts opts.json? ? Pf.json(cards) : Pf.table(cards.map { |card| { id: card["id"], pos: card["position"], title: card["title"], query: Pf::Cards.describe(card) } })
  end

  hiiro.add_cmd :show, :run, args: ["CARD_ID"], opts: [:json] do
    store = Pf.writable_store
    card = store.get_card(Pf.number_arg(opts.args[0], "card id"))
    raise Pf::Error, "no such card" unless card
    result = store.card_items(card)
    if opts.json?
      puts Pf.json(card.merge(result))
    else
      PfCards.print_card_result(card, result)
    end
  end

  hiiro.add_cmd :preview, :query, opts: [*card_opts, :json] do
    store = Pf.store
    spec = Pf::Cards.normalize(PfCards.input_from("preview", opts))
    result = store.card_items(spec)
    if opts.json?
      puts Pf.json(spec.merge(result))
    else
      total = result["total"].to_i
      items = result["items"] || []
      suffix = total > items.length ? " of #{total}" : ""
      puts "#{Pf::Cards.describe(spec)}  (#{items.length}#{suffix})"
      items.each { |item| puts "  #{item["title"]} [#{item["type"]} ##{item["id"]}]" }
    end
  end

  hiiro.add_cmd :add, :new, args: ["PORTFOLIO", "TITLE"], opts: card_opts do
    store = Pf.writable_store
    portfolio = PfCards.portfolio_of(store, opts.args[0])
    title = opts.args[1..]&.join(" ")
    id = store.create_card(portfolio["id"], PfCards.input_from(title, opts))
    puts "created card ##{id} in #{portfolio["name"]}"
  end

  hiiro.add_cmd :edit, :set, args: ["CARD_ID", "TITLE..."], opts: card_opts do
    store = Pf.writable_store
    id = Pf.number_arg(opts.args[0], "card id")
    title = opts.args[1..]&.join(" ")
    patch = PfCards.input_from(title.to_s.empty? ? nil : title, opts)
    raise Pf::Error, "no such card" unless store.update_card(id, patch)
    card = store.get_card(id)
    puts "updated card ##{id}: #{Pf::Cards.describe(card)}"
  end

  hiiro.add_cmd :move, args: ["CARD_ID", "left|right"] do
    store = Pf.writable_store
    card = store.get_card(Pf.number_arg(opts.args[0], "card id"))
    raise Pf::Error, "no such card" unless card
    direction = opts.args[1] == "left" || opts.args[1] == "right" ? opts.args[1] : nil
    raise Pf::Error, "direction must be left or right" unless direction
    puts store.move_card(card, direction) ? "moved" : "already at the edge"
  end

  hiiro.add_cmd :rm, :remove, :delete, args: ["CARD_ID"] do
    store = Pf.writable_store
    puts store.delete_card(Pf.number_arg(opts.args[0], "card id")) ? "deleted" : "no such card"
  end
end
