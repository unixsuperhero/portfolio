#!/usr/bin/env ruby
# pf-projects — parent directories to scan for projects; each found project becomes a dir item in the project category.
require_relative "../lib/pf"
require_relative "../lib/pf/projects"

Pf.run do |hiiro|
  hiiro.add_flag :json, short: "j", desc: "print JSON"
  hiiro.add_option :depth, short: "d", type: :integer, desc: "levels to walk (default #{Pf::Projects::SCAN_DEPTH})"

  hiiro.add_cmd :ls, :list, args: ["QUERY..."], opts: Pf.add_list_options(hiiro) do
    store = Pf.store
    category = store.find_category("project")
    unless category
      puts "no project category yet; add a parent with pf-projects parents add"
      exit 1
    end
    q = opts.args.join(" ").downcase
    items = store.category_members(category["id"]).select do |item|
      q.empty? || item["title"].downcase.include?(q) || item["path"].to_s.downcase.include?(q)
    end
    Pf.print_items(store, items, opts)
  end

  hiiro.add_cmd :scan do
    store = Pf.writable_store
    added = store.scan_projects
    puts "added #{added.length} projects"
    added.each { |path| puts "  #{Pf.abbreviate_path(path)}" }
  end

  hiiro.add_cmd :discover, args: ["DIR"], opts: [:depth, :json] do
    raise Pf::Error, "directory required" unless opts.args[0]
    found = Pf::Projects.discover(Pf.expand_path(opts.args[0]), opts.depth || Pf::Projects::SCAN_DEPTH)
    puts opts.json? ? Pf.json(found) : found.map { |path| Pf.abbreviate_path(path) }.join("\n")
  end

  hiiro.add_cmd :parents, passthrough: true do
    run_child(:parents, args, external_commands: false, builtin_commands: false) do
      add_flag :json, short: "j", desc: "print JSON"
      add_cmd :ls, :list, opts: [:json] do
        rows = Pf.store.list_project_parents
        puts opts.json? ? Pf.json(rows) : Pf.table(rows.map { |row| { id: row["id"], path: Pf.abbreviate_path(row["path"]), projects: row["count"] } })
      end
      add_cmd :add, args: ["DIR"] do
        raise Pf::Error, "directory required" unless opts.args[0]
        store = Pf.writable_store
        store.add_project_parent(File.expand_path(Pf.expand_path(opts.args[0])))
        added = store.scan_projects
        puts "added #{added.length} projects"
      ensure
        store&.close
      end
      add_cmd :rm, :remove, args: ["ID"] do
        store = Pf.writable_store
        puts store.remove_project_parent(Pf.number_arg(opts.args[0])) ? "removed" : "no such parent"
      ensure
        store&.close
      end
    end
  end
end
