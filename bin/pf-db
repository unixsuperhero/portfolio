#!/usr/bin/env ruby
# pf-db — the SQLite file itself: where it is, its schema state, ad-hoc queries, backups.
require_relative '../lib/pf'
require_relative '../lib/pf/database'
require 'time'

module PfDb
  module_function

  def size(bytes)
    bytes >= 1_048_576 ? format('%.1f MB', bytes / 1_048_576.0) : bytes >= 1024 ? format('%.1f KB', bytes / 1024.0) : "#{bytes} B"
  end
end

Pf.run do
  add_cmd(:path) { puts Pf.database_path }
  add_cmd(:status) do
    path = Pf.database_path
    raise Pf::Error, "no database at #{path}" unless File.exist?(path)
    store = Pf.store
    puts "#{path} (#{PfDb.size(File.size(path))})"
    tables = store.query("SELECT name FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%' AND name NOT LIKE 'items_fts%' ORDER BY name")
    puts Pf.table(tables.map { |r| { 'table' => r['name'], 'rows' => store.one(%Q{SELECT count(*) n FROM "#{r['name']}"})['n'] } })
  ensure
    store&.close
  end
  add_cmd(:init) { Pf::Database.init!; puts "ready: #{Pf.database_path}" }
  add_flag :live, short: :l, desc: 'read from the database instead of schema.sql'
  add_cmd(:schema, opts: [:live]) do
    if opts.live
      store = Pf.store
      store.query('SELECT sql FROM sqlite_master WHERE sql IS NOT NULL ORDER BY type DESC, name').each { |r| puts r['sql'] + ';' }
    else
      print Pf::Database.schema, "\n"
    end
  ensure
    store&.close
  end
  add_flag :json, short: :j, desc: 'print JSON'
  add_flag :all, short: :a, desc: 'no 50-row limit'
  add_cmd(:q, :query, args: ['SQL...'], opts: [:json, :all]) do
    sql = opts.args.join(' ').strip
    raise Pf::Error, 'SQL required' if sql.empty?
    db = Pf::Database.open
    if sql =~ /^\s*(select|with|pragma|explain)/i
      rows = Pf::Database.rows(db, sql)
      shown = opts.all ? rows : rows.first(50)
      puts(opts.json ? Pf.json(shown) : Pf.table(shown))
      puts "(#{shown.length} of #{rows.length} rows; --all for everything)" if !opts.json && rows.length > shown.length
    else
      db.execute(sql)
      puts "changes: #{db.changes}"
    end
  ensure
    db&.close
  end
  add_cmd(:backup, args: ['DEST']) do
    dest = opts.args[0] || "#{Pf.database_path}.#{Time.now.utc.iso8601.gsub(/[:.]/, '-')}"
    store = Pf.store
    store.db.execute('VACUUM INTO ?', dest)
    puts "backup: #{dest} (#{PfDb.size(File.size(dest))})"
  ensure
    store&.close
  end
  add_cmd(:vacuum) do
    db = Pf::Database.open; db.execute_batch('PRAGMA wal_checkpoint(TRUNCATE); VACUUM')
    puts "vacuumed (#{PfDb.size(File.size(Pf.database_path))})"
  ensure
    db&.close
  end
  add_cmd(:reindex) do
    db = Pf::Database.open; db.execute("INSERT INTO items_fts(items_fts) VALUES ('rebuild')")
    puts 'search index rebuilt'
  ensure
    db&.close
  end
  add_cmd(:sqlite) do
    bin = Pf.which('sqlite3')
    raise Pf::Error, 'sqlite3 not on PATH' unless bin
    system(bin, Pf.database_path)
  end
end
