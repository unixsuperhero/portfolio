#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/pf"
require_relative "../lib/pf/server"

Pf.run do
  add_flag :follow, short: "f", desc: "keep following"
  add_flag :json, short: "j", desc: "print JSON"
  add_option :limit, short: "l", type: :integer, desc: "limit"

  add_cmd :url do
    puts Pf.server_url
  end

  add_cmd :health do
    puts Pf.json(Pf.client.get("/health"))
  end

  add_cmd :open, args: ["PATH"] do
    Pf.open_default("#{Pf.server_url}#{opts.args[0] || ""}")
  end

  add_cmd :setup do
    Pf::Server.run_installer
  end

  add_cmd :start do
    Pf::Server.start
  end

  add_cmd :stop do
    unless Pf::Server.loaded?
      puts "not loaded"
      next 0
    end
    Pf::Server.launchctl("bootout", Pf::Server.target)
  end

  add_cmd :restart do
    Pf::Server.start(restart: true)
  end

  add_cmd :status do
    raise Pf::Error, "not loaded; run pf-server start" unless Pf::Server.loaded?
    Pf::Server.launchctl("print", Pf::Server.target)
  end

  add_cmd :logs, opts: [:follow] do
    logs = ["stdout.log", "stderr.log"].map { |name| File.join(Pf::Server.logs_dir, name) }.select { |path| File.exist?(path) }
    raise Pf::Error, "no logs yet" if logs.empty?
    args = opts.follow? ? ["-f"] : ["-n", "40"]
    system("tail", *args, *logs)
    $?.exitstatus || 1
  end

  add_cmd :dev, args: ["PORT"] do
    port = opts.args[0] || "4388"
    env = ENV.to_h.merge("PORT" => port)
    exec(env, ENV["BUN_BIN"] || ENV["BUN"] || "bun", "run", File.join(Pf.project_root, "app.js"))
  end

  add_cmd :api, args: ["PATH"] do
    puts Pf.json(Pf.client.get(opts.args[0] || "/health"))
  end

  add_cmd :items, args: ["QUERY..."], opts: [:limit, :json] do
    query = {}
    query[:q] = opts.args.join(" ") unless opts.args.empty?
    query[:limit] = opts.limit if opts.limit
    items = Pf.client.get("/api/items", query: query).fetch("items")
    rows = items.map { |item| { "id" => item["id"], "type" => item["type"], "title" => item["title"], "tags" => Array(item["tags"]).join(",") } }
    puts(opts.json? ? Pf.json(items) : Pf.table(rows))
  end
end
