#!/usr/bin/env ruby
# pf-tags — tags and what carries them.
require_relative '../lib/pf'

Pf.run do |h|
  Pf.add_list_options(h)
  h.add_flag(:json, short: 'j', desc: 'print JSON')

  list_opts = Pf::LIST_OPTIONS

  h.add_cmd(:ls, :list, opts: [:json]) do
    store = Pf.store
    tags = store.list_tags
    puts(opts.json? ? Pf.json(tags) : Pf.table(tags.map { |tag| { 'id' => tag['id'], 'name' => tag['name'], 'count' => tag['count'] } }))
  ensure
    store&.close
  end

  h.add_cmd(:items, :show, args: ['TAG'], opts: list_opts) do
    raise Pf::Error, 'tag name required' unless opts.args[0]
    store = Pf.store
    Pf.print_items(store, store.list_items(tag_name: opts.args[0], type: opts.type || ''), opts)
  ensure
    store&.close
  end

  h.add_cmd(:rename, args: ['OLD', 'NEW']) do
    old_name, new_name = opts.args
    store = Pf.writable_store
    tag = store.one('SELECT * FROM tags WHERE name = ? COLLATE NOCASE', old_name.to_s)
    raise Pf::Error, 'usage: pf-tags rename OLD NEW' unless tag && new_name
    store.rename_tag(tag['id'], new_name)
    puts "#{tag['name']} → #{new_name}"
  ensure
    store&.close
  end

  h.add_cmd(:rm, :remove, args: ['TAG']) do
    name = opts.args[0]
    store = Pf.writable_store
    tag = store.one('SELECT * FROM tags WHERE name = ? COLLATE NOCASE', name.to_s)
    raise Pf::Error, "no tag named #{name}" unless tag
    store.remove_tag(tag['id'])
    puts "removed tag #{tag['name']}"
  ensure
    store&.close
  end

  h.add_cmd(:prune) do
    store = Pf.writable_store
    puts "pruned #{store.prune_tags} tags"
  ensure
    store&.close
  end

  h.add_cmd(:add, args: ['TAG', 'ID...']) do
    tag, *ids = opts.args
    raise Pf::Error, 'usage: pf-tags add TAG ID...' unless tag && ids.any?
    store = Pf.writable_store
    ids.each { |id| store.set_tags(Pf.number_arg(id), [tag]) }
    puts "tagged #{ids.length} items with #{tag}"
  ensure
    store&.close
  end
end
