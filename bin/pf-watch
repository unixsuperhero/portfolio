#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/pf"
require_relative "../lib/pf/watch"

Pf.run do
  add_flag :json, short: "j", desc: "print JSON"
  add_flag :recursive, short: "r", desc: "include subdirectories"

  add_cmd :ls, :list, opts: [:json] do
    store = Pf.store
    rows = store.list_watched_directories.map do |dir|
      { "id" => dir["id"], "path" => Pf.abbreviate_path(dir["path"]), "recursive" => Pf::Watch.truthy?(dir["recursive"]) ? "yes" : "no", "documents" => store.claimed_item_ids(dir["id"]).length }
    end
    puts(opts.json? ? Pf.json(rows) : Pf.table(rows))
  ensure
    store&.close
  end

  add_cmd :add, args: ["DIR"], opts: [:recursive] do
    path = Pf::Watch.absolute_dir(opts.args[0])
    result = Pf::Watch.add(path, recursive: opts.recursive?)
    id = result["id"]
    state = (result["states"] || []).find { |candidate| candidate["id"] == id } || {}
    count = state["count"] || 0
    suffix = state["error"] ? " (error: #{state["error"]})" : ""
    puts "watching ##{id}: #{count} documents#{suffix}"
  end

  add_cmd :set, args: ["ID", "recursive|flat"] do
    recursive = opts.args[1] == "recursive"
    raise Pf::Error, "second argument must be recursive or flat" unless recursive || opts.args[1] == "flat"
    result = Pf::Watch.set(Pf.number_arg(opts.args[0]), recursive: recursive)
    puts "synced; removed #{result.fetch("removed", 0)} uncovered documents"
  end

  add_cmd :rm, :remove, args: ["ID"] do
    result = Pf::Watch.remove(Pf.number_arg(opts.args[0]))
    puts "removed #{result.fetch("removed", 0)} documents"
  end

  add_cmd :sync do
    Pf::Watch.sync_lines(Pf::Watch.sync).each { |line| puts line }
  end

  add_cmd :scan, args: ["DIR"], opts: [:recursive, :json] do
    rows = Pf::Watch.scan_rows(Pf::Watch.absolute_dir(opts.args[0]), recursive: opts.recursive?)
    puts(opts.json? ? Pf.json(rows) : Pf.table(rows))
  end

  add_cmd :run do
    $stdout.sync = true
    interval = (ENV["PF_WATCH_POLL_SECONDS"] || "2").to_f
    interval = 2.0 if interval <= 0
    store = Pf.store
    dirs = store.list_watched_directories
    signatures = dirs.to_h { |dir| [dir["id"], Pf::Watch.signature(dir)] }
    Pf::Watch.sync_lines(Pf::Watch.sync).each { |line| puts line }
    puts "watching #{dirs.length} directories; ctrl-c to stop"
    loop do
      sleep interval
      store.close if store
      store = Pf.store
      dirs = store.list_watched_directories
      changed = false
      dirs.each do |dir|
        sig = Pf::Watch.signature(dir)
        changed ||= signatures[dir["id"]] != sig
        signatures[dir["id"]] = sig
      end
      signatures.keys.each { |id| signatures.delete(id) unless dirs.any? { |dir| dir["id"] == id } }
      next unless changed
      Pf::Watch.sync_lines(Pf::Watch.sync).each { |line| puts line }
    end
  ensure
    store&.close
  end
end
