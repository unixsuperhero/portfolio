#!/usr/bin/env ruby
# pf-portfolios — pages of cards. Each card is a saved query; see pf-cards.
require_relative "../lib/pf"
require_relative "../lib/pf/cards"

module PfPortfolios
  module_function

  def resolve(store, word)
    if word&.match?(/^\d+$/)
      found = store.get_portfolio(word.to_i)
      return found if found
    end
    if word
      found = store.find_portfolio(word)
      return found if found
    end
    all = store.list_portfolios.select { |portfolio| !word || portfolio["name"].downcase.include?(word.downcase) }
    raise Pf::Error, (word ? "no portfolio matching #{word}" : "no portfolios yet") if all.empty?
    picked = Pf.pick_one(all) { |portfolio| "#{portfolio["name"]} [##{portfolio["id"]}]" }
    raise Pf::Error, "nothing chosen" unless picked
    picked
  end

  def portfolio_view(store, portfolio)
    view = portfolio.dup
    view["cards"] = store.portfolio_cards(portfolio["id"]).map do |card|
      if card["kind"] == "query" || !card.key?("kind")
        card.merge(store.card_items(card))
      else
        card.merge("items" => [], "total" => 0)
      end
    end
    view
  end
end

Pf.run do |hiiro|
  hiiro.add_flag :json, short: "j", desc: "print JSON"
  hiiro.add_option :description, short: "d", desc: "new description"

  hiiro.add_cmd :ls, :list, opts: [:json] do
    rows = Pf.store.list_portfolios
    puts opts.json? ? Pf.json(rows) : Pf.table(rows.map { |p| { id: p["id"], name: p["name"], cards: p["card_count"], description: p["description"] } })
  end

  hiiro.add_cmd :show, args: ["NAME|ID"], opts: [:json] do
    store = Pf.store
    portfolio = PfPortfolios.resolve(store, opts.args[0])
    view = PfPortfolios.portfolio_view(store, portfolio)
    if opts.json?
      puts Pf.json(view)
      next
    end

    puts "#{view["name"]} [##{view["id"]}]#{view["description"].to_s.empty? ? "" : " — #{view["description"]}"}"
    view["cards"].each do |card|
      items = card["items"] || []
      total = card["total"].to_i
      suffix = total > items.length ? " of #{total}" : ""
      puts
      puts "## #{card["title"]} [card ##{card["id"]}]  #{Pf::Cards.describe(card)}  (#{items.length}#{suffix})"
      items.each { |item| puts "   #{item["title"]} [#{item["type"]} ##{item["id"]}]" }
      puts "   (nothing matches yet)" if items.empty?
    end
  end

  hiiro.add_cmd :new, :add, :create, args: ["NAME", "DESCRIPTION..."] do
    name, *rest = opts.args
    raise Pf::Error, "name required" if name.to_s.empty?
    store = Pf.writable_store
    puts "created portfolio ##{store.create_portfolio(name, rest.join(" "))}"
  ensure
    store&.close
  end

  hiiro.add_cmd :rename, args: ["NAME|ID", "NEW_NAME"], opts: [:description] do
    store = Pf.writable_store
    portfolio = PfPortfolios.resolve(store, opts.args[0])
    store.update_portfolio(portfolio["id"], { name: opts.args[1], description: opts.description }.compact)
    puts "updated ##{portfolio["id"]}"
  end

  hiiro.add_cmd :rm, :remove, :delete, args: ["NAME|ID"] do
    store = Pf.writable_store
    portfolio = PfPortfolios.resolve(store, opts.args[0])
    store.delete_portfolio(portfolio["id"])
    puts "deleted #{portfolio["name"]}"
  end

  hiiro.add_cmd :open, args: ["NAME|ID"] do
    store = Pf.store
    portfolio = PfPortfolios.resolve(store, opts.args[0])
    Pf.open_default("#{Pf.server_url}/portfolios/#{portfolio["id"]}")
  end
end
