#!/usr/bin/env bun
// pf-portfolios — pages of cards. Each card is a saved query; see pf-cards.
import { cli, flag, json, numberArg, table, openDefault, CliError, pickOne } from "@portfolio/cli-kit";
import { openDefaultStore } from "@portfolio/cli";
import { describeCard } from "@portfolio/core";
import { defaultServer } from "@portfolio/client";
import type { Store } from "@portfolio/db";

function resolvePortfolio(store: Store, word: string | undefined) {
  if (word && /^\d+$/.test(word)) { const found = store.portfolios.getPortfolio(Number(word)); if (found) return found; }
  if (word) { const found = store.portfolios.findPortfolio(word); if (found) return found; }
  const all = store.portfolios.listPortfolios().filter(p => !word || p.name.toLowerCase().includes(word.toLowerCase()));
  if (!all.length) throw new CliError(word ? `no portfolio matching ${word}` : "no portfolios yet");
  const picked = pickOne(all, p => `${p.name} [#${p.id}]`);
  if (!picked) throw new CliError("nothing chosen");
  return picked;
}

cli("pf-portfolios", c => {
  c.cmd(["ls", "list"], { desc: "every portfolio with its card count", opts: { json: flag("j", "print JSON") } }, ({ opts, out }) => {
    const store = openDefaultStore({ readonly: true });
    const rows = store.portfolios.listPortfolios();
    out(opts.json ? json(rows) : table(rows.map(p => ({ id: p.id, name: p.name, cards: p.card_count, description: p.description }))));
  });

  c.cmd("show", { desc: "a portfolio with its cards and their matching items", args: ["NAME|ID"], opts: { json: flag("j", "print JSON, the same payload as /api/portfolios/:id") } }, ({ args, opts, out }) => {
    const store = openDefaultStore({ readonly: true });
    const portfolio = resolvePortfolio(store, args[0]);
    const view = store.portfolios.portfolioView(portfolio);
    if (opts.json) return out(json(view));
    out(`${view.name} [#${view.id}]${view.description ? ` — ${view.description}` : ""}`);
    for (const card of view.cards) {
      out();
      out(`## ${card.title} [card #${card.id}]  ${describeCard(card)}  (${card.items.length}${card.total > card.items.length ? ` of ${card.total}` : ""})`);
      for (const item of card.items) out(`   ${item.title} [${item.type} #${item.id}]`);
      if (!card.items.length) out("   (nothing matches yet)");
    }
  });

  c.cmd(["new", "add", "create"], { desc: "create a portfolio", args: ["NAME", "DESCRIPTION..."] }, ({ args, out }) => {
    const store = openDefaultStore();
    const [name, ...rest] = args;
    if (!name) throw new CliError("name required");
    out(`created portfolio #${store.portfolios.createPortfolio(name, rest.join(" "))}`);
  });

  c.cmd("rename", { desc: "rename a portfolio or change its description", args: ["NAME|ID", "NEW_NAME"], opts: { description: { kind: "option", short: "d", desc: "new description" } } }, ({ args, opts, out }) => {
    const store = openDefaultStore();
    const portfolio = resolvePortfolio(store, args[0]);
    store.portfolios.updatePortfolio(portfolio.id, { name: args[1], description: opts.description ?? undefined });
    out(`updated #${portfolio.id}`);
  });

  c.cmd(["rm", "remove", "delete"], { desc: "delete a portfolio and its cards; items are kept", args: ["NAME|ID"] }, ({ args, out }) => {
    const store = openDefaultStore();
    const portfolio = resolvePortfolio(store, args[0]);
    store.portfolios.deletePortfolio(portfolio.id);
    out(`deleted ${portfolio.name}`);
  });

  c.cmd("open", { desc: "open the portfolio page in the browser", args: ["NAME|ID"] }, ({ args }) => {
    const store = openDefaultStore({ readonly: true });
    const portfolio = resolvePortfolio(store, args[0]);
    return openDefault(`${process.env.PORTFOLIO_SERVER ?? defaultServer()}/portfolios/${portfolio.id}`);
  });
}, { desc: "portfolios: pages of query cards" }).run();
