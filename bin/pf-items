#!/usr/bin/env ruby
# pf-items — list, search, inspect, flag, tag, open, and remove items straight from the database.
require_relative '../lib/pf'

Pf.run do |h|
  Pf.add_list_options(h)
  h.add_flag(:all, short: 'a', desc: 'open every match')
  h.add_flag(:copy, desc: 'copy the first path to the clipboard')
  h.add_flag(:files, desc: 'also delete the tracked source file')
  h.add_flag(:yes, short: 'y', desc: 'do not ask')

  list_opts = Pf::LIST_OPTIONS

  h.add_cmd(:ls, :list, :search, args: ['QUERY...'], opts: list_opts) do
    store = Pf.store
    Pf.print_items(store, Pf.find_items(store, opts.args, opts), opts)
  ensure
    store&.close
  end

  h.add_cmd(:recent, args: ['N'], opts: list_opts) do
    store = Pf.store
    args = opts.args.dup
    n = args[0]&.match?(/^\d+$/) ? args.shift.to_i : 10
    Pf.print_items(store, Pf.find_items(store, args, opts.to_h.merge(limit: n)), opts)
  ensure
    store&.close
  end

  h.add_cmd(:count) do
    store = Pf.store
    counts = store.query('SELECT type, COUNT(*) AS count FROM items GROUP BY type').to_h { |row| [row['type'], row['count']] }
    rows = Pf::ITEM_TYPES.map { |type| { 'type' => type, 'count' => counts.fetch(type, 0) } }
    puts Pf.table(rows + [{ 'type' => 'total', 'count' => counts.values.sum }])
  ensure
    store&.close
  end

  h.add_cmd(:show, :get, args: ['ID|QUERY...'], opts: list_opts) do
    store = Pf.store
    item = Pf.pick_item(store, opts.args, opts)
    next false unless item
    puts Pf.json(store.view_item(item).merge('content' => item['content'], 'slots' => store.member_slots(item), 'category_id' => item['category_id']))
  ensure
    store&.close
  end

  h.add_cmd(:cat, args: ['ID|QUERY...'], opts: list_opts) do
    store = Pf.store
    item = Pf.pick_item(store, opts.args, opts)
    next false unless item
    puts(item['content'].empty? ? (item['source_path'] || item['url'] || item['path'] || '') : item['content'])
  ensure
    store&.close
  end

  h.add_cmd(:open, args: ['ID|QUERY...'], opts: list_opts + [:all]) do
    store = Pf.store
    items = opts.all? ? Pf.find_items(store, opts.args, opts) : [Pf.pick_item(store, opts.args, opts)].compact
    items.each { |item| Pf.open_default(Pf.item_url(item)) }
  ensure
    store&.close
  end

  h.add_cmd(:vim, :edit, args: ['QUERY...'], opts: list_opts) do
    store = Pf.store
    paths = Pf.find_items(store, opts.args, opts).filter_map { |item| item['source_path'] || item['path'] }
    if paths.empty?
      puts 'No matching local sources.'
      next false
    end
    Pf.edit_files(paths)
  ensure
    store&.close
  end

  h.add_cmd(:path, args: ['QUERY...'], opts: list_opts + [:copy]) do
    store = Pf.store
    paths = Pf.find_items(store, opts.args, opts).filter_map { |item| item['path'] || item['source_path'] }
    paths.each { |path| puts(opts.full? ? path : Pf.abbreviate_path(path)) }
    Pf.copy_to_clipboard(paths[0]) if opts.copy? && paths[0]
  ensure
    store&.close
  end

  [%w[pin pinned true pin], %w[unpin pinned false unpin], %w[star starred true star], %w[unstar starred false unstar]].each do |name, field, raw_value, desc|
    h.add_cmd(name.to_sym, args: ['ID...']) do
      store = Pf.writable_store
      ids = opts.args.map { |id| Pf.number_arg(id) }
      store.set_item_flag(ids, field, raw_value == 'true')
      puts "#{desc}: #{ids.join(', ')}"
    ensure
      store&.close
    end
  end

  h.add_cmd(:toggle, args: ['ID', 'pinned|starred']) do
    id = Pf.number_arg(opts.args[0])
    field = opts.args[1] == 'starred' ? 'starred' : opts.args[1] == 'pinned' ? 'pinned' : nil
    unless field
      puts 'field must be pinned or starred'
      next false
    end
    store = Pf.writable_store
    puts 'no such item' unless store.toggle_item_field(id, field)
  ensure
    store&.close
  end

  h.add_cmd(:tag, args: ['ID', 'TAGS']) do
    id = Pf.number_arg(opts.args[0])
    store = Pf.writable_store
    store.set_tags(id, Pf.parse_tags(opts.args[1..].join(',')))
    puts "##{id}: #{store.tag_names_for(id).join(', ')}"
  ensure
    store&.close
  end

  h.add_cmd(:untag, args: ['ID', 'TAGS']) do
    id = Pf.number_arg(opts.args[0])
    store = Pf.writable_store
    store.remove_tags(id, Pf.parse_tags(opts.args[1..].join(',')))
    tags = store.tag_names_for(id).join(', ')
    puts "##{id}: #{tags.empty? ? '(no tags)' : tags}"
  ensure
    store&.close
  end

  h.add_cmd(:set, args: ['ID', 'FIELD', 'VALUE...']) do
    id, field, *rest = opts.args
    allowed = %w[title description url type content]
    unless allowed.include?(field)
      puts "field must be one of #{allowed.join(', ')}"
      next false
    end
    id = Pf.number_arg(id)
    store = Pf.writable_store
    unless store.update_item(id, { field => rest.join(' ') })
      puts 'no such item'
      next false
    end
    puts "##{id} #{field} updated"
  ensure
    store&.close
  end

  h.add_cmd(:rm, :remove, :delete, args: ['ID|QUERY...'], opts: list_opts + [:files, :yes]) do
    store = Pf.writable_store
    item = Pf.pick_item(store, opts.args, opts)
    next false unless item
    delete_source = opts.files? && item['source_path']
    unless Pf.confirm("Remove #{Pf.label(item)}#{delete_source ? " and delete #{item['source_path']}" : ''}?", assume: (opts.yes? ? true : nil))
      puts 'cancelled'
      next 1
    end
    FileUtils.rm_f(item['source_path']) if delete_source
    store.delete_items([item['id']])
    puts "removed #{Pf.label(item)}"
  ensure
    store&.close
  end

  h.add_cmd(:export, args: ['QUERY...'], opts: list_opts) do
    store = Pf.store
    Pf.find_items(store, opts.args, opts).each do |item|
      puts JSON.generate(store.view_item(item).merge('content' => item['content'], 'category_id' => item['category_id']))
    end
  ensure
    store&.close
  end
end
