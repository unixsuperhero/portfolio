#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/pf'
require_relative '../lib/pf/detect'
require_relative '../lib/pf/render'

Pf.run do
  add_option :title, short: 't', desc: 'document title (default: first heading or file name)'
  add_option :out, short: 'o', desc: 'write to this file instead of stdout'
  add_flag :toc, desc: 'table of contents (default)'
  add_flag :no_toc, long: 'no-toc', desc: 'omit the table of contents'
  add_flag :fragment, short: 'f', desc: 'HTML fragment only, no template'
  add_option :template, desc: 'pandoc template path'
  add_flag :open, desc: 'open the written file'

  add_default do
    opts = options.select(%i[title out toc no_toc fragment template open]).parse(all_args)
    next puts(opts.help_text) if opts.help?
    raise Pf::Error, "pandoc not found (looked for #{Pf::Render.pandoc_bin}); brew install pandoc" unless Pf::Render.pandoc_available?

    source = opts.args[0]
    raise Pf::Error, 'file required, or - for stdin' unless source

    markdown = source == '-' ? Pf.read_stdin : File.read(source, encoding: 'UTF-8')
    path = source == '-' ? 'stdin.md' : File.expand_path(source)
    title = opts.title || Pf::Detect.document_title(markdown, path)
    html = if opts.fragment?
             Pf::Render.render_fragment(markdown)
           else
             Pf::Render.render_markdown(markdown, title: title, toc: !opts.no_toc?, template: opts.template)
           end
    unless opts.out
      print html, "\n"
      next
    end
    File.write(opts.out, html)
    puts "wrote #{opts.out}"
    Pf.open_default(opts.out) if opts.open?
  end

  add_cmd 'template' do
    puts Pf::Render::DEFAULT_TEMPLATE
  end

  add_cmd 'check' do
    ok = Pf::Render.pandoc_available?
    puts "#{Pf::Render.pandoc_bin}  #{ok ? 'ok' : 'MISSING'}"
    ok
  end
end
