#!/usr/bin/env ruby
# pf-categories — a category names a kind of item and the slots (files/dirs) every member has.
require_relative "../lib/pf"

module PfCategories
  module_function

  def category_of(store, word)
    found = if word&.match?(/^\d+$/)
      store.get_category(word.to_i)
    elsif word
      store.find_category(word)
    end
    raise Pf::Error, "no category #{word || "(missing)"}; run pf-categories ls" unless found
    found
  end

  def parse_slots(value)
    value.to_s.lines.map(&:strip).reject(&:empty?).map do |line|
      name, kind, path = line.split("|").map(&:strip)
      raise Pf::Error, "slot \"#{line}\" must read: name | file or dir | path" unless name && !name.empty? && %w[file dir].include?(kind) && path && !path.empty?
      { "name" => name, "kind" => kind, "path" => path }
    end.tap do |slots|
      names = slots.map { |slot| slot["name"].downcase }
      raise Pf::Error, "slot names must be unique" unless names.uniq.length == names.length
    end
  end

  def format_slots(slots)
    Array(slots).map { |slot| "#{slot["name"]} | #{slot["kind"]} | #{slot["path"]}" }.join("\n")
  end
end

Pf.run do |hiiro|
  hiiro.add_flag :json, short: "j", desc: "print JSON"
  slot_options = Hiiro::Options.setup do
    option :slots, short: "s", desc: "slots, one per line: name | file or dir | path"
    option :kind, short: "k", desc: "kind of item"
  end

  hiiro.add_cmd :ls, :list, opts: [:json] do
    rows = Pf.store.list_categories
    puts opts.json? ? Pf.json(rows) : Pf.table(rows.map { |cat| { id: cat["id"], name: cat["name"], kind: cat["kind"], members: cat["member_count"], slots: PfCategories.format_slots(cat["slots"]).gsub("\n", "; ") } })
  end

  hiiro.add_cmd :items, :members, args: ["CATEGORY"], opts: Pf.add_list_options(hiiro) do
    store = Pf.store
    Pf.print_items(store, store.category_members(PfCategories.category_of(store, opts.args[0])["id"]), opts)
  end

  hiiro.add_cmd :slots, args: ["ITEM_ID"], opts: [:json] do
    store = Pf.store
    item = store.get_item(Pf.number_arg(opts.args[0], "item id"))
    raise Pf::Error, "no such item" unless item
    slots = store.member_slots(item)
    puts opts.json? ? Pf.json(slots) : Pf.table(slots.map { |slot| { name: slot["name"], kind: slot["kind"], path: slot["path"] ? Pf.abbreviate_path(slot["path"]) : "(needs a member path)", exists: slot["exists"] ? "yes" : "no", overridden: slot["overridden"] ? "yes" : "" } })
  end

  hiiro.add_subcmd :add, :new, opts: slot_options, subcmd_args: ["NAME"], subcmd_opts: slot_options do |opts|
    next puts(opts.help_text) if opts.help?
    kind = opts.kind || "dir"
    raise Pf::Error, "invalid kind" unless Pf::ITEM_TYPES.include?(kind)
    store = Pf.writable_store
    puts "created category ##{store.create_category("name" => opts.args[0] || "", "kind" => kind, "slots" => PfCategories.parse_slots(opts.slots || ""))}"
  ensure
    store&.close
  end

  hiiro.add_subcmd :edit, :set, opts: slot_options, subcmd_args: ["CATEGORY", "NEW_NAME"], subcmd_opts: slot_options do |opts|
    next puts(opts.help_text) if opts.help?
    store = Pf.writable_store
    category = PfCategories.category_of(store, opts.args[0])
    raise Pf::Error, "invalid kind" if opts.kind && !Pf::ITEM_TYPES.include?(opts.kind)
    patch = {}
    patch[:name] = opts.args[1] if opts.args[1]
    patch[:kind] = opts.kind if opts.kind
    patch[:slots] = PfCategories.parse_slots(opts.slots) unless opts.slots.nil?
    store.update_category(category["id"], patch)
    puts "updated #{category["name"]}"
  end

  hiiro.add_cmd :assign, args: ["ITEM_ID", "CATEGORY"] do
    store = Pf.writable_store
    item = store.get_item(Pf.number_arg(opts.args[0], "item id"))
    raise Pf::Error, "no such item" unless item
    category = PfCategories.category_of(store, opts.args[1])
    raise Pf::Error, "category #{category["name"]} holds #{category["kind"]} items, this is a #{item["type"]}" unless category["kind"] == item["type"]
    store.update_item(item["id"], { "category_id" => category["id"] })
    puts "##{item["id"]} → #{category["name"]}"
  end

  hiiro.add_cmd :unassign, args: ["ITEM_ID"] do
    store = Pf.writable_store
    item = store.get_item(Pf.number_arg(opts.args[0], "item id"))
    raise Pf::Error, "no such item" unless item
    store.update_item(item["id"], { "category_id" => nil })
    puts "##{item["id"]} has no category"
  end

  hiiro.add_cmd :override, args: ["ITEM_ID", "SLOT", "PATH"] do
    store = Pf.writable_store
    item = store.get_item(Pf.number_arg(opts.args[0], "item id"))
    raise Pf::Error, "no such item" unless item
    raise Pf::Error, "slot name required" unless opts.args[1]
    store.set_slot_override(item, opts.args[1], opts.args[2] || "")
    puts Pf.json(store.member_slots(store.get_item(item["id"])))
  end

  hiiro.add_cmd :rm, :remove, :delete, args: ["CATEGORY"] do
    store = Pf.writable_store
    category = PfCategories.category_of(store, opts.args[0])
    store.delete_category(category["id"])
    puts "deleted #{category["name"]}"
  end
end
